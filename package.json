{
	"name": "yawnpm",
	"version": "0.4.0",
	"description": "tired of switching between package managers?",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tijnjh/yawn.git"
	},
	"license": "MIT",
	"author": "tijnjh",
	"type": "module",
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		}
	},
	"main": "./dist/index.cjs",
	"types": "./dist/index.d.ts",
	"bin": {
		"yawn": "dist/index.cjs"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "unbuild"
	},
	"dependencies": {
		"citty": "^0.2.1",
		"consola": "^3.4.2",
		"destr": "^2.0.5",
		"didyoumean": "^1.2.2",
		"package-manager-detector": "^1.6.0"
	},
	"devDependencies": {
		"@trivago/prettier-plugin-sort-imports": "^6.0.0",
		"@types/didyoumean": "^1.2.3",
		"@types/node": "^24.10.0",
		"prettier": "^3.6.2",
		"type-fest": "^5.2.0",
		"unbuild": "^3.6.1"
	}
}

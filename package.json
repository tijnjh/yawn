{
	"name": "yawnpm",
	"version": "0.6.0",
	"description": "tired of switching between package managers?",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tijnjh/yawn.git"
	},
	"license": "MIT",
	"author": "tijnjh",
	"type": "module",
	"packageManager": "pnpm@11.9.0",
	"main": "./dist/index.js",
	"bin": {
		"yawn": "dist/index.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"prepack": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json"
	},
	"dependencies": {
		"citty": "^0.2.1",
		"consola": "^3.4.2",
		"destr": "^2.0.5",
		"didyoumean": "^1.2.2",
		"package-manager-detector": "^1.6.0"
	},
	"devDependencies": {
		"@trivago/prettier-plugin-sort-imports": "^6.0.2",
		"@types/didyoumean": "^1.2.3",
		"@types/node": "^25.5.0",
		"prettier": "^3.8.1",
		"type-fest": "^5.5.0",
		"typescript": "^6.0.3"
	}
}
